# ============================================================
# Cloud-1 local deployment configuration
# Copy this file to .env and edit values locally.
# Do NOT commit .env.
# ============================================================

# Target EC2 instance
AWS_HOST_ALIAS=wp1
AWS_ELASTIC_IP=YOUR_ELASTIC_IP
ANSIBLE_USER=ubuntu
SSH_KEY_PATH=~/.ssh/cloud1-aws.pem

# Remote deployment path on the EC2 instance
CLOUD1_PROJECT_DIR=/opt/cloud1

# DuckDNS
DUCKDNS_SUBDOMAIN=your-duckdns-subdomain
ENABLE_DUCKDNS=true

# TLS / Let's Encrypt
ENABLE_TLS=true
LETSENCRYPT_EMAIL=your-email@example.com
LETSENCRYPT_STAGING=false

# phpMyAdmin access restriction
# Example: 82.225.34.226/32
PHPMYADMIN_ALLOWED_CIDR=YOUR_PUBLIC_IP/32