---
# Create the real file with:
#   ansible-vault create group_vars/vault.yml
#
# Or copy this file, edit values, then encrypt it:
#   cp group_vars/vault.yml.example group_vars/vault.yml
#   nano group_vars/vault.yml
#   ansible-vault encrypt group_vars/vault.yml
#
# The committed real file must start with:
#   $ANSIBLE_VAULT;1.1;AES256

vault_db_password: CHANGE_ME_LONG_RANDOM_WORDPRESS_DB_PASSWORD
vault_db_root_password: CHANGE_ME_LONG_RANDOM_MYSQL_ROOT_PASSWORD
vault_duckdns_token: CHANGE_ME_DUCKDNS_TOKEN
